  "version": "2.0.0",
  "license": "GPL-3.0-or-later",
  "author": "Zam233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zam233/dsh-smartlib.git"
  },
  "homepage": "https://github.com/Zam233/dsh-smartlib#readme",
  "bugs": {
    "url": "https://github.com/Zam233/dsh-smartlib/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "smartlib",
    "academic-search",
    "citation-check",
    "literature"
  ],
